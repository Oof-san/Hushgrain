# Default is a browser-local portfolio sandbox. No accounts or services required.
DATA_MODE=demo
PORT=3000
# For live ordering: DATA_MODE=live. Local SQLite runs without a hosted account.
DATABASE_URL=file:./data/hushgrain.db
# On Vercel live mode, use a Turso libsql:// URL and its token.
DATABASE_AUTH_TOKEN=
# Set the exact public origin when deploying live.
APP_ORIGIN=http://localhost:3000
# Generate with npm run password:hash. Never put plaintext passwords here.
ADMIN_PASSWORD_HASH=
# A randomly generated secret, at least 32 characters. Server-only.
ADMIN_SESSION_SECRET=
